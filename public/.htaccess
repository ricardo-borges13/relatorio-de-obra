Options -Indexes -MultiViews

DirectoryIndex index.html

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>

    <Files "sw.js">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Service-Worker-Allowed "/"
    </Files>

    <FilesMatch "\.(?:html|webmanifest|txt)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(?:js|css|woff2?)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(?:png|jpg|jpeg|webp|svg|ico)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>

</IfModule>

<IfModule mod_rewrite.c>

    RewriteEngine On
    RewriteBase /

    RewriteOptions IgnoreInherit

    # ---------------------------------------------------------
    # NEXT.JS APP ROUTER - RSC
    # ---------------------------------------------------------

    # Requisições com ?_rsc=... devem receber o payload .txt
    # Exemplo:
    # /relatorios/novo/?_rsc=abc
    # -> /relatorios/novo.txt
    RewriteCond %{QUERY_STRING} (^|&)_rsc=
    RewriteCond %{DOCUMENT_ROOT}/$1.txt -f
    RewriteRule ^(.+?)/?$ /$1.txt [L]

    # ---------------------------------------------------------
    # NEXT.JS STATIC EXPORT - HTML
    # ---------------------------------------------------------

    # /relatorios/novo
    # /relatorios/novo/
    # -> /relatorios/novo.html
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ /$1.html [L]

    # Arquivos físicos reais
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Diretórios físicos reais
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

</IfModule>